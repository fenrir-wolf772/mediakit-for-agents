{
  "version": 1,
  "input": "source.mp4",
  "output": "../outputs/mcp-manifest.mp4",
  "steps": [
    {"tool": "trim", "args": {"start": 2, "end": 8}},
    {"tool": "reframe", "args": {"mode": "blur", "width": 1080, "height": 1920}},
    {"tool": "loudness", "args": {"target_lufs": -14}}
  ],
  "qa": "tiktok"
}
